{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["app/src/**/*.ts", "tests/**/*.ts", "pages/**/*.ts", "api/**/*.ts", "fixtures/**/*.ts", "config/**/*.ts", "playwright.config.ts"]
}
